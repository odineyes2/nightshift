diff --git a/apps/web/src/nightshift/client.ts b/apps/web/src/nightshift/client.ts
new file mode 100644
index 0000000..c020e68
--- /dev/null
+++ b/apps/web/src/nightshift/client.ts
@@ -0,0 +1,98 @@
+// nightshift 연동: 공유 세션(토큰)으로 파일을 가져오고, 내보낸 결과를 다시 올려 보낸다.
+// 미디어는 이 브라우저와 nightshift 서버 사이에서만 오간다.
+
+const ORIGIN = (process.env.NEXT_PUBLIC_NIGHTSHIFT_ORIGIN ?? "").replace(
+	/\/+$/,
+	"",
+);
+const STORAGE_KEY = "nightshift-share-session";
+
+export interface NightshiftFile {
+	index: number;
+	name: string;
+	kind: "image" | "video";
+	size: number;
+	url: string;
+}
+
+interface Manifest {
+	files: NightshiftFile[];
+	upload_url: string;
+}
+
+export function isNightshiftConfigured(): boolean {
+	return ORIGIN !== "";
+}
+
+function sameOriginUrl({ url }: { url: string }): string {
+	const resolved = new URL(url, ORIGIN);
+	if (resolved.origin !== new URL(ORIGIN).origin) {
+		throw new Error("nightshift returned a URL for another origin");
+	}
+	return resolved.toString();
+}
+
+export function rememberSession({ token }: { token: string }): void {
+	sessionStorage.setItem(STORAGE_KEY, token);
+}
+
+export function getRememberedSession(): string | null {
+	return typeof window === "undefined" ? null : sessionStorage.getItem(STORAGE_KEY);
+}
+
+export async function fetchManifest({
+	token,
+}: {
+	token: string;
+}): Promise<Manifest> {
+	const response = await fetch(
+		sameOriginUrl({ url: `/api/shared/sessions/${encodeURIComponent(token)}` }),
+	);
+	if (!response.ok) {
+		throw new Error(
+			response.status === 404
+				? "This nightshift link has expired. Open the editor again from nightshift."
+				: `nightshift returned ${response.status}`,
+		);
+	}
+	return response.json();
+}
+
+export async function downloadFile({
+	file,
+}: {
+	file: NightshiftFile;
+}): Promise<File> {
+	const response = await fetch(sameOriginUrl({ url: file.url }));
+	if (!response.ok) {
+		throw new Error(`Failed to download ${file.name} (${response.status})`);
+	}
+	const blob = await response.blob();
+	return new File([blob], file.name, { type: blob.type });
+}
+
+export async function uploadResult({
+	token,
+	buffer,
+	filename,
+	mimeType,
+}: {
+	token: string;
+	buffer: ArrayBuffer;
+	filename: string;
+	mimeType: string;
+}): Promise<{ output: string }> {
+	const manifest = await fetchManifest({ token });
+	const target = new URL(sameOriginUrl({ url: manifest.upload_url }));
+	target.searchParams.set("name", filename);
+	const response = await fetch(target, {
+		method: "POST",
+		headers: { "Content-Type": mimeType },
+		body: new Blob([buffer], { type: mimeType }),
+	});
+	if (!response.ok) {
+		const detail = await response.json().catch(() => null);
+		throw new Error(detail?.detail ?? `Upload failed (${response.status})`);
+	}
+	return response.json();
+}
diff --git a/apps/web/src/nightshift/use-nightshift-import.ts b/apps/web/src/nightshift/use-nightshift-import.ts
new file mode 100644
index 0000000..f27ac3b
--- /dev/null
+++ b/apps/web/src/nightshift/use-nightshift-import.ts
@@ -0,0 +1,82 @@
+import { useEffect } from "react";
+import { toast } from "sonner";
+import { useEditor } from "@/editor/use-editor";
+import { processMediaAssets } from "@/media/processing";
+import { buildElementFromMedia } from "@/timeline/element-utils";
+import { AddMediaAssetCommand } from "@/commands/media";
+import { InsertElementCommand } from "@/commands/timeline";
+import { BatchCommand } from "@/commands";
+import { mediaTimeFromSeconds } from "@/wasm";
+import {
+	downloadFile,
+	fetchManifest,
+	isNightshiftConfigured,
+	rememberSession,
+} from "./client";
+
+const IMAGE_DEFAULT_SECONDS = 5;
+const handledTokens = new Set<string>();
+
+// /editor/<id>?ns=<token>: nightshift가 고른 파일을 내려받아 타임라인에 순서대로 놓는다.
+export function useNightshiftImport() {
+	const editor = useEditor();
+	const projectId = useEditor(
+		(e) => e.project.getActiveOrNull()?.metadata.id ?? null,
+	);
+
+	useEffect(() => {
+		if (!projectId || !isNightshiftConfigured()) return;
+		const token = new URLSearchParams(window.location.search).get("ns");
+		if (!token || handledTokens.has(token)) return;
+		handledTokens.add(token);
+		rememberSession({ token });
+		window.history.replaceState(null, "", window.location.pathname);
+
+		const run = async () => {
+			const manifest = await fetchManifest({ token });
+			const files: File[] = [];
+			for (const entry of manifest.files) {
+				files.push(await downloadFile({ file: entry }));
+			}
+			const assets = await processMediaAssets({ files });
+			let cursorSeconds = 0;
+			for (const asset of assets) {
+				const addMediaCmd = new AddMediaAssetCommand({ projectId, asset });
+				const seconds =
+					asset.type === "image" || asset.duration == null
+						? IMAGE_DEFAULT_SECONDS
+						: asset.duration;
+				const element = buildElementFromMedia({
+					mediaId: addMediaCmd.getAssetId(),
+					mediaType: asset.type,
+					name: asset.name,
+					duration: mediaTimeFromSeconds({ seconds }),
+					startTime: mediaTimeFromSeconds({ seconds: cursorSeconds }),
+					buffer:
+						asset.type === "audio"
+							? new AudioBuffer({ length: 1, sampleRate: 44100 })
+							: undefined,
+				});
+				const insertCmd = new InsertElementCommand({
+					element,
+					placement: {
+						mode: "auto",
+						trackType: asset.type === "audio" ? "audio" : "video",
+					},
+				});
+				editor.command.execute({
+					command: new BatchCommand([addMediaCmd, insertCmd]),
+				});
+				cursorSeconds += seconds;
+			}
+			return assets.length;
+		};
+
+		toast.promise(run(), {
+			loading: "Loading files from nightshift...",
+			success: (count) => `${count} file(s) added from nightshift`,
+			error: (error) =>
+				error instanceof Error ? error.message : "Failed to load from nightshift",
+		});
+	}, [editor, projectId]);
+}
-- 
