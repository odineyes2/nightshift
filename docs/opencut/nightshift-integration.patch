--- /dev/null
+++ b/apps/web/src/app/nightshift/page.tsx
@@ -0,0 +1,47 @@
+"use client";
+
+import { Suspense, useEffect, useRef, useState } from "react";
+import { useRouter, useSearchParams } from "next/navigation";
+import { useEditor } from "@/editor/use-editor";
+
+function NightshiftEntry() {
+	const editor = useEditor();
+	const router = useRouter();
+	const params = useSearchParams();
+	const token = params.get("ns");
+	const started = useRef(false);
+	const [error, setError] = useState<string | null>(null);
+
+	useEffect(() => {
+		if (started.current) return;
+		started.current = true;
+		if (!token) {
+			setError(
+				"Missing nightshift link. Open the editor from nightshift's gallery.",
+			);
+			return;
+		}
+		editor.project
+			.createNewProject({ name: "nightshift edit" })
+			.then((projectId) => {
+				router.replace(`/editor/${projectId}?ns=${encodeURIComponent(token)}`);
+			})
+			.catch((e) =>
+				setError(e instanceof Error ? e.message : "Failed to create project"),
+			);
+	}, [editor, router, token]);
+
+	return (
+		<div className="text-muted-foreground flex h-screen w-screen items-center justify-center text-sm">
+			{error ?? "Preparing your nightshift project..."}
+		</div>
+	);
+}
+
+export default function NightshiftPage() {
+	return (
+		<Suspense>
+			<NightshiftEntry />
+		</Suspense>
+	);
+}
