# notify_ntfy.sh(웹앱 접속 주소를 ntfy.sh로 폰에 알림)와 app.py(잡 큐 서버)가
# 읽는 환경변수 예시. 이 파일을 .env로 복사한 뒤 값을 채우세요 — .env는 git으로
# 버전 관리되지 않습니다(.gitignore 참고).
#
#   cp .env.example .env
#   vi .env

# app.py가 읽는다. 설정하면 /api/* 요청에 이 값과 같은 X-API-Key 헤더(또는
# Authorization: Bearer 헤더)를 요구한다 — 비워두면(기본) 인증 없이 실행된다.
# 외부에 노출하거나 LLM이 이 API를 직접 호출하게 할 계획이라면 반드시 설정할 것.
# 예: python3 -c "import secrets; print(secrets.token_urlsafe(32))" 로 생성.
NIGHTSHIFT_API_KEY=

# app.py가 읽는다. nightshift가 작업을 보낼 ComfyUI 주소의 "배포 기본값".
# 우선순위는 (1) 화면에서 저장한 설정(comfy_endpoint.json) > (2) 이 환경변수 >
# (3) 자동 탐지(127.0.0.1:8188 → :8000) 순이다. ComfyUI가 원격(예: GPU pod)에
# 있으면 화면(헤더의 연결 상태 배지 클릭)에서 저장하는 쪽이 편하다 — 재시작 없이
# 바뀌고, pod를 새로 만들어 주소가 바뀔 때마다 여기를 고칠 필요가 없다.
#COMFY_URL=http://127.0.0.1:8188

# app.py가 읽는다. 대기/실행 중인 작업(pending+queued+running) 합계가 이 값
# 이상이면 새 작업 추가(POST /api/upload)를 429로 거부한다. 반복 호출하는
# 스크립트나 LLM의 버그로 큐가 한없이 쌓이는 걸 막기 위한 안전장치 — 작업마다
# 실제 GPU 시간이 드니까. 비밀값이 아니라 기본값(100)이 app.py에 코드로
# 박혀 있고, 여기 설정하면 그 값을 덮어쓴다.
#NIGHTSHIFT_MAX_ACTIVE_JOBS=100

# app.py가 읽는다. 워커가 작업을 실행하려는 순간 ComfyUI에 연결되지 않으면 그
# 작업을 실패시키지 않고 붙잡아 둔 채(화면에는 "GPU 대기") 이 간격(초)마다 다시
# 확인한다. ComfyUI를 원격 GPU pod에 두고 nightshift만 홈서버에 상시 띄우는
# 구성에서는 pod가 꺼져 있는 시간이 정상이라, 그동안 쌓아둔 작업이 전부 실패로
# 떨어지지 않게 하기 위한 값이다. 비밀값이 아니라 기본값(15)이 app.py에 코드로
# 박혀 있고, 여기 설정하면 그 값을 덮어쓴다.
#NIGHTSHIFT_COMFY_WAIT_RETRY_SEC=15

# comfy_outputs.py가 읽는다. ComfyUI가 원격(GPU pod)에 있을 때 결과 이미지를
# HTTP로 끌어오는 동작의 조정값. SYNC_MAX_ITEMS는 ComfyUI의 /history에서 훑어볼
# 최근 프롬프트 개수인데, 한 작업이 이미지 수만큼 프롬프트를 만들기 때문에 한 번에
# 500장 넘게 뽑는다면 올려야 한다. 가져오기를 켜고 끄는 것은 화면(헤더의 연결 상태
# 배지 클릭)에서 하고, 어디까지 받아왔는지는 comfy_output_sync.json에 기록된다.
#NIGHTSHIFT_SYNC_MAX_ITEMS=500
#NIGHTSHIFT_SYNC_TIMEOUT_SEC=60

# drivers/shell.py가 읽는다. 셸 파드(등록한 머신에서 임의 명령을 돌리는 워커)를
# 쓸 수 있게 한다. 기본은 꺼짐 — 정의상 임의 명령 실행이라, nightshift가 인증 없이
# 떠 있으면 그 포트에 닿는 누구나 이 머신에서 아무 명령이나 돌릴 수 있게 된다.
# 켤 거라면 위의 NIGHTSHIFT_API_KEY도 반드시 함께 설정할 것.
#NIGHTSHIFT_ENABLE_SHELL_PODS=1
# 셸 명령을 실행할 기본 작업 폴더(파드마다 note 필드로 따로 지정할 수 있다).
#NIGHTSHIFT_SHELL_WORKDIR=/home/me/nightshift

# mcp_server.py(app.py를 MCP 도구로 감싸는 별도 프로세스)가 읽는다.
# JOB_QUEUE_BASE_URL: app.py가 떠 있는 주소. 같은 머신에서 돈다면 RunPod
# 프록시 URL 대신 내부 주소를 쓰는 게 더 빠르고 안정적이다. 생략하면
# http://127.0.0.1:8000 을 쓴다.
#JOB_QUEUE_BASE_URL=http://127.0.0.1:8000

# NIGHTSHIFT_API_KEY를 설정해뒀다면 여기도 같은 값을 넣어야 mcp_server.py가
# app.py를 호출할 수 있다(X-API-Key 헤더로 실어 보낸다). 비워두면 헤더 자체를
# 안 보낸다 — NIGHTSHIFT_API_KEY도 비어 있을 때만 정상 동작한다.
#JOB_QUEUE_API_KEY=

# mcp_server.py가 뜰 포트. app.py의 NIGHTSHIFT_PORT(기본 8000)와 겹치면 안 된다.
#MCP_SERVER_PORT=8001

# (필수) ntfy.sh 토픽 이름. ntfy 앱에서 같은 이름으로 구독해야 알림을 받는다.
# 아무나 추측할 수 없는 이름을 쓰는 걸 권장한다 (ntfy.sh 공개 토픽은 이름만 알면 누구나 구독 가능).
NTFY_TOPIC=

# 웹앱이 떠 있는 포트. 포트를 정하는 곳은 여기 한 군데다 — ecosystem.config.js가
# 이 값으로 uvicorn --port를 넘기고, 템플릿이 진행 상황을 보고할 주소(app.py의
# SELF_URL)도 이 값에서 유도된다. 예전에는 세 곳에 따로 적어야 했고 어긋나면
# 진행률 바가 조용히 안 움직였다.
NIGHTSHIFT_PORT=8000

# app.py가 읽는다. 템플릿이 진행 상황을 보고할 때 쓸 nightshift 자신의 주소를
# 통째로 지정한다. 보통은 위 NIGHTSHIFT_PORT에서 유도한 http://127.0.0.1:<포트>가
# 맞으므로 비워두면 되고, 리버스 프록시 뒤처럼 그게 안 맞는 배치에서만 쓴다.
#NIGHTSHIFT_SELF_URL=http://127.0.0.1:8000

# app.py가 읽는다. 명시적으로 지정된 ComfyUI 주소의 연결 확인 타임아웃(초).
# 자동 탐지 후보(127.0.0.1)는 2초 고정이고, 이 값은 원격일 수 있는 주소에만
# 적용된다 — WAN 왕복 + TLS 핸드셰이크가 붙으면 2초는 쉽게 넘는다.
#NIGHTSHIFT_COMFY_TIMEOUT_SEC=5

# 헬스체크 최대 대기 시간(초)과 폴링 간격(초). 생략하면 기본값(30초, 2초)을 쓴다.
#NTFY_HEALTHCHECK_TIMEOUT_SEC=30
#NTFY_HEALTHCHECK_INTERVAL_SEC=2

# 알림 로그를 남길 파일 경로. 생략하면 ./logs/notify_ntfy.log를 쓴다.
#NTFY_LOG_FILE=./logs/notify_ntfy.log
