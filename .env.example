# notify_ntfy.sh(웹앱 접속 주소를 ntfy.sh로 폰에 알림)와 app.py(잡 큐 서버)가
# 읽는 환경변수 예시. 이 파일을 .env로 복사한 뒤 값을 채우세요 — .env는 git으로
# 버전 관리되지 않습니다(.gitignore 참고).
#
#   cp .env.example .env
#   vi .env

# app.py가 읽는다. 회원제라서 사람은 아이디/비밀번호로 로그인한다 — 예전의 NIGHTSHIFT_API_KEY 방식은 없어졌다
# (남아 있어도 무시된다). 가입 신청은 누구나 넣을 수 있지만 관리자가 승인해야 쓸 수 있다.
#
# 관리자(admin) 계정: 서버가 시작할 때 admin이 아직 없으면 아래 값으로 만든다. 비밀번호는 필수(8자 이상)이고, 이미
# admin이 있으면 이 값은 무시된다(비밀번호는 화면의 "My account"에서 바꾼다). 인터넷에 열어 둘 거라면 길게 잡을 것.
# 예: python3 -c "import secrets; print(secrets.token_urlsafe(18))" 로 생성.
NIGHTSHIFT_ADMIN_USER=admin
NIGHTSHIFT_ADMIN_PASSWORD=
#NIGHTSHIFT_ADMIN_EMAIL=admin@example.com

# app.py와 mcp_server.py가 같이 읽는 MCP 전용 내부 키(권장). 설정하면 MCP 서버가 로그인하지 않고 이 키로
# admin 권한을 받는다 — 사람의 admin 비밀번호를 여기 적어 둘 필요가 없어진다(그 비밀번호는 JupyterLab
# 게이트의 열쇠이기도 해서 .env에 두면 위험하다). app.py는 같은 머신에서 프록시를 거치지 않고 직접 온
# 요청일 때만 이 키를 인정하고(Cloudflare 터널로 들어온 요청은 키가 맞아도 거절), 이 키로는 계정·회원
# 관리 API(/api/auth/*, /api/admin/*)를 못 쓴다. 32자 이상이어야 켜진다. claude.ai 커넥터에 넣는
# MCP_AUTH_TOKEN과는 다른 값이어야 한다 — 이 키는 서버 밖으로 나가지 않는 게 방어선의 전부다.
# 예: python3 -c "import secrets; print(secrets.token_urlsafe(32))" 로 생성.
#NIGHTSHIFT_MCP_KEY=

# (NIGHTSHIFT_MCP_KEY가 없을 때만) mcp_server.py가 app.py에 로그인할 회원 — 그 회원의 권한·소유 범위
# 안에서만 도구가 동작한다. 예전 방식이라 새로 설정한다면 위의 NIGHTSHIFT_MCP_KEY를 쓸 것.
#JOB_QUEUE_USER=admin
#JOB_QUEUE_PASSWORD=

# app.py가 읽는다. nightshift가 작업을 보낼 ComfyUI 주소의 "배포 기본값".
# 우선순위는 (1) 화면에서 저장한 설정(comfy_endpoint.json) > (2) 이 환경변수 >
# (3) 자동 탐지(127.0.0.1:8188 → :8000) 순이다. ComfyUI가 원격(예: GPU pod)에
# 있으면 화면(헤더의 연결 상태 배지 클릭)에서 저장하는 쪽이 편하다 — 재시작 없이
# 바뀌고, pod를 새로 만들어 주소가 바뀔 때마다 여기를 고칠 필요가 없다.
#COMFY_URL=http://127.0.0.1:8188

# app.py가 읽는다. 대기/실행 중인 작업(pending+queued+running) 합계가 이 값
# 이상이면 새 작업 추가(POST /api/upload)를 429로 거부한다. 반복 호출하는
# 스크립트나 LLM의 버그로 큐가 한없이 쌓이는 걸 막기 위한 안전장치 — 작업마다
# 실제 GPU 시간이 드니까. 비밀값이 아니라 기본값(100)이 app.py에 코드로
# 박혀 있고, 여기 설정하면 그 값을 덮어쓴다.
#NIGHTSHIFT_MAX_ACTIVE_JOBS=100

# app.py가 읽는다. 워커가 작업을 실행하려는 순간 ComfyUI에 연결되지 않으면 그
# 작업을 실패시키지 않고 붙잡아 둔 채(화면에는 "GPU 대기") 이 간격(초)마다 다시
# 확인한다. ComfyUI를 원격 GPU pod에 두고 nightshift만 홈서버에 상시 띄우는
# 구성에서는 pod가 꺼져 있는 시간이 정상이라, 그동안 쌓아둔 작업이 전부 실패로
# 떨어지지 않게 하기 위한 값이다. 비밀값이 아니라 기본값(15)이 app.py에 코드로
# 박혀 있고, 여기 설정하면 그 값을 덮어쓴다.
#NIGHTSHIFT_COMFY_WAIT_RETRY_SEC=15

# drivers/comfyui.py(runpod_api.py)가 읽는다. 설정하면 파드의 url이 RunPod 프록시
# 주소(https://{POD_ID}-{PORT}.proxy.runpod.net/)일 때 RunPod API로 그 파드의
# 이름(RunPod가 자동으로 붙인 것)·GPU 종류·시간당 비용·생성/최근 시작 일시를 가져와
# 대시보드 카드에 얹는다. RunPod 콘솔(Settings → API Keys)에서 발급받는다. 비워두면
# 이 기능은 그냥 꺼진다 — 카드의 나머지 정보에는 영향 없음.
#RUNPOD_API_KEY=

# runpod_sync.py가 읽는다. RunPod pod를 자동 등록할 때(server/mcp_server.py의
# sync_runpod_pods 도구, 또는 아래 RUNPOD_SYNC_INTERVAL_SEC의 주기적 실행) ComfyUI가
# 노출된 포트로 볼 값. 비워두면 8188을 쓴다(ComfyUI 기본 포트).
#RUNPOD_SYNC_COMFY_PORT=8188

# app.py가 읽는다. 0보다 크면 그 간격(초)마다 관리자 권한으로 RunPod pod 자동 동기화를
# 백그라운드에서 돈다(RunPod에서 pod를 켜면 Claude 없이도 몇 분 안에 nightshift 파드
# 목록에 나타난다). 기본은 0(꺼짐) — RUNPOD_API_KEY도 같이 설정해야 의미가 있다.
#RUNPOD_SYNC_INTERVAL_SEC=0

# drivers/claude_writer.py(templates/claude_write.py)가 읽는다. Claude API 키.
# 설정해야만 "Claude 글쓰기" 파드 종류를 추가할 수 있다(파드 종류 선택지 자체에
# 안 뜬다) — 이 워커는 원격 GPU가 아니라 이 프로세스가 직접 Claude API를 불러
# 글을 쓰므로, 다른 파드처럼 주소를 저장하는 대신 이 키 하나만 있으면 된다.
# https://console.anthropic.com/settings/keys 에서 발급받는다.
#ANTHROPIC_API_KEY=

# comfy_outputs.py가 읽는다. ComfyUI가 원격(GPU pod)에 있을 때 결과 이미지를
# HTTP로 끌어오는 동작의 조정값. SYNC_MAX_ITEMS는 ComfyUI의 /history에서 훑어볼
# 최근 프롬프트 개수인데, 한 작업이 이미지 수만큼 프롬프트를 만들기 때문에 한 번에
# 500장 넘게 뽑는다면 올려야 한다. 가져오기를 켜고 끄는 것은 화면(헤더의 연결 상태
# 배지 클릭)에서 하고, 어디까지 받아왔는지는 comfy_output_sync.json에 기록된다.
#NIGHTSHIFT_SYNC_MAX_ITEMS=500
#NIGHTSHIFT_SYNC_TIMEOUT_SEC=60

# drivers/shell.py가 읽는다. 셸 파드(등록한 머신에서 임의 명령을 돌리는 워커)를
# 쓸 수 있게 한다. 기본은 꺼짐 — 정의상 임의 명령 실행이라, 켜도 관리자(admin)만 만들고 쓸 수 있다
# (일반 회원은 셸 파드를 만들 수 없다).
#NIGHTSHIFT_ENABLE_SHELL_PODS=1
# 셸 명령을 실행할 기본 작업 폴더(파드마다 note 필드로 따로 지정할 수 있다).
#NIGHTSHIFT_SHELL_WORKDIR=/home/me/nightshift

# mcp_server.py(app.py를 MCP 도구로 감싸는 별도 프로세스)가 읽는다.
# JOB_QUEUE_BASE_URL: app.py가 떠 있는 주소. 같은 머신에서 돈다면 RunPod
# 프록시 URL 대신 내부 주소를 쓰는 게 더 빠르고 안정적이다. 생략하면
# http://127.0.0.1:8000 을 쓴다.
#JOB_QUEUE_BASE_URL=http://127.0.0.1:8000

# mcp_server.py가 뜰 포트. app.py의 NIGHTSHIFT_PORT(기본 8000)와 겹치면 안 된다.
#MCP_SERVER_PORT=8001

# mcp_server.py가 묶일 주소. 기본 127.0.0.1 — 외부 노출은 Cloudflare Tunnel 같은
# 리버스 프록시로만 하고(jupyterlab을 127.0.0.1에 묶은 것과 같은 이유,
# ecosystem.config.js 주석 참고), 이 값 자체를 0.0.0.0으로 바꾸는 건 터널 설정을
# 이미 걸어 뒀고 아래 MCP_AUTH_TOKEN도 같이 설정했을 때만 안전하다.
#MCP_SERVER_HOST=127.0.0.1

# 설정하면 이 값과 일치하는 `Authorization: Bearer <토큰>` 헤더 또는 `/mcp/<토큰>`
# 경로로 온 요청만 MCP 서버가 받아준다(TokenAuthMiddleware, server/mcp_server.py).
# 비워두면 인증이 아예 없다 — MCP_SERVER_HOST를 127.0.0.1로 둔 채로만 그렇게 두는
# 게 안전하다(외부에 노출하면서 이 값을 안 채우면 시작할 때 경고가 찍힌다).
# python3 -c "import secrets; print(secrets.token_urlsafe(24))" 로 만들면 된다.
#MCP_AUTH_TOKEN=

# (필수) ntfy.sh 토픽 이름. ntfy 앱에서 같은 이름으로 구독해야 알림을 받는다.
# 아무나 추측할 수 없는 이름을 쓰는 걸 권장한다 (ntfy.sh 공개 토픽은 이름만 알면 누구나 구독 가능).
NTFY_TOPIC=

# 웹앱이 떠 있는 포트. 포트를 정하는 곳은 여기 한 군데다 — ecosystem.config.js가
# 이 값으로 uvicorn --port를 넘기고, 템플릿이 진행 상황을 보고할 주소(app.py의
# SELF_URL)도 이 값에서 유도된다. 예전에는 세 곳에 따로 적어야 했고 어긋나면
# 진행률 바가 조용히 안 움직였다.
NIGHTSHIFT_PORT=8000

# data_paths.py가 읽는다. 돌면서 생기는 것(작업 기록·로그·최근 파일·파드 목록·화면에서
# 저장한 설정)이 전부 여기 모인다. 비워두면 <저장소>/data — 소스와 생성물을 갈라놓는 게
# 목적이라 보통 그대로 두면 되고, 데이터만 다른 디스크/볼륨에 두고 싶을 때 지정한다.
# 결과 이미지는 여기가 아니라 NIGHTSHIFT_OUTPUT_DIR로 따로 정한다.
#NIGHTSHIFT_DATA_DIR=/workspace/nightshift-data

# app.py가 읽는다. 템플릿이 진행 상황을 보고할 때 쓸 nightshift 자신의 주소를
# 통째로 지정한다. 보통은 위 NIGHTSHIFT_PORT에서 유도한 http://127.0.0.1:<포트>가
# 맞으므로 비워두면 되고, 리버스 프록시 뒤처럼 그게 안 맞는 배치에서만 쓴다.
#NIGHTSHIFT_SELF_URL=http://127.0.0.1:8000

# app.py가 읽는다. 명시적으로 지정된 ComfyUI 주소의 연결 확인 타임아웃(초).
# 자동 탐지 후보(127.0.0.1)는 2초 고정이고, 이 값은 원격일 수 있는 주소에만
# 적용된다 — WAN 왕복 + TLS 핸드셰이크가 붙으면 2초는 쉽게 넘는다.
#NIGHTSHIFT_COMFY_TIMEOUT_SEC=5

# 헬스체크 최대 대기 시간(초)과 폴링 간격(초). 생략하면 기본값(30초, 2초)을 쓴다.
#NTFY_HEALTHCHECK_TIMEOUT_SEC=30
#NTFY_HEALTHCHECK_INTERVAL_SEC=2

# 알림 로그를 남길 파일 경로. 생략하면 ./data/logs/notify_ntfy.log를 쓴다.
#NTFY_LOG_FILE=./data/logs/notify_ntfy.log

# 영상 편집(자르기/이어 붙이기) — ffmpeg 경로(비우면 PATH, 그다음 imageio-ffmpeg의 것을 씀)와 동시에 도는 편집 수
#NIGHTSHIFT_FFMPEG=
#NIGHTSHIFT_EDIT_CONCURRENCY=2

# OpenCut 편집기 연동 — 편집기 공개 주소(비우면 기능 꺼짐, 생략하면 https://opencut.lomebrote.com)
#NIGHTSHIFT_OPENCUT_URL=https://opencut.lomebrote.com
# 개발용으로 편집기 출처를 더 허용(쉼표 구분), 예: http://localhost:3100
#NIGHTSHIFT_OPENCUT_EXTRA_ORIGINS=
# 편집기에서 올려 보내는 결과 영상 크기 상한(MB)
#NIGHTSHIFT_SHARE_UPLOAD_MAX_MB=2048

# 로그인 쿠키를 이 도메인의 모든 서브도메인에 공유한다(예: lomebrote.com) — opencut.lomebrote.com
# 앞의 로그인 게이트(server/opencut_gate.py)가 nightshift 로그인을 그대로 인식하게 하려면 필요하다.
# 비우면(기본) 지금처럼 nightshift 서브도메인 전용(host-only) 쿠키다.
#NIGHTSHIFT_COOKIE_DOMAIN=
