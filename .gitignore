# 로그, 기록

jobs/*
logs/*
recent_workflows/*
recent_csvs/*
workflow_presets/*

# 배포 환경마다 다른 런타임 설정 — 화면에서 저장하면 생긴다(pod 주소 등이 들어가므로 커밋하지 않는다)
comfy_endpoint.json

# 파이썬 캐시
__pycache__/
*.pyc

# pm2 실행용 npm 의존성 (package.json만 커밋, 실제 모듈은 npm install로 각자 받음)
node_modules/

# ntfy.sh 토픽 등 민감정보 — .env.example만 커밋하고 실제 .env는 각자 만들어 씀
.env