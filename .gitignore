# 로그, 기록

jobs/*
logs/*
recent_workflows/*
recent_csvs/*
workflow_presets/*

# 배포 환경마다 다른 런타임 설정 — 화면에서 저장하면 생긴다(pod 주소 등이 들어가므로 커밋하지 않는다)
comfy_endpoint.json

# 파드(워커) 목록 — 배포 환경마다 다르고 pod 주소가 들어가므로 커밋하지 않는다.
# comfy_endpoint.json이 있으면 첫 실행 때 파드 1개짜리 목록으로 자동 이관된다.
pods.json

# 원격 ComfyUI에서 결과 이미지를 어디까지 받아왔는지의 기록(comfy_outputs.py) —
# 배포 환경마다 다르고 지운 이미지가 되살아나지 않게 하는 용도라 커밋하지 않는다.
comfy_output_sync.json

# 파이썬 캐시
__pycache__/
*.pyc

# pm2 실행용 npm 의존성 (package.json만 커밋, 실제 모듈은 npm install로 각자 받음)
node_modules/

# ntfy.sh 토픽 등 민감정보 — .env.example만 커밋하고 실제 .env는 각자 만들어 씀
.env